# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix will cache dependencies in.
/deps/

# Where third-party dependencies like ExDoc write generated docs.
/doc/

# Ignore .fetch files, in case you like to use "mix deps.get --no-compile"
.fetch

# If the VM crashes, it generates a dump, let's ignore it
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build")
*.ez

# Ignore package tarball (built via "mix hex.build")
*.tar

# Temporary files
*.swp
*.swo
*~
.DS_Store

# IDE / Language Server files
.elixir_ls/
.vscode/
.idea/

